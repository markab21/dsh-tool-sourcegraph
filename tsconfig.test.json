{
  /*
   * Typechecks this project's source AND its tests.
   *
   * It extends tsconfig.json, so the tests are held to the same settings as the
   * source they exercise. An earlier revision extended a separate config for the
   * vendored tree, which inherited the two flags relaxed for third-party code
   * and silently weakened the check for our own source — a false-negative channel
   * inside `pnpm run typecheck`, where a broken test still reported clean.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["upstream", "node_modules", "dist"],
  "references": []
}
