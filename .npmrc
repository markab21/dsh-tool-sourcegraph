# Store the pnpm content-addressable store inside the project.
#
# The default store lives in the user's home directory, which:
#   - is outside this project (and outside the sandbox this project is often
#     built in), and
#   - resolves through a stray `pnpm-workspace.yaml` in the user's HOME, which
#     makes pnpm treat HOME as the workspace root and try to manage
#     `~/node_modules` instead of this project's.
#
# `pnpm-workspace.yaml` in this directory already marks the project as its own
# workspace root. This keeps the store local too, so installs are hermetic and
# reproducible.
store-dir=.pnpm-store

# Non-interactive installs must be able to repair a modules directory without a
# TTY prompt (for example after an interrupted install).
confirm-modules-purge=false
