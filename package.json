{
  "name": "dsh-tool-sourcegraph",
  "version": "0.2.0",
  "description": "Sourcegraph code search for DeepSeek Harness: search indexed code across repositories from the agent loop.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.vendor.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "pnpm run release && publint && npm pack --dry-run",
    "release": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sourcegraph",
    "code-search",
    "code-intelligence"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "publint": "0.3.24",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markab21/dsh-tool-sourcegraph.git"
  },
  "homepage": "https://github.com/markab21/dsh-tool-sourcegraph#readme",
  "bugs": {
    "url": "https://github.com/markab21/dsh-tool-sourcegraph/issues"
  },
  "dependencies": {}
}
