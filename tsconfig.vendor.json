{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],

    /*
     * Relaxed relative to the root config, and deliberately so.
     *
     * The files under src/vendor are third-party code written against a
     * configuration this project does not control. Under the same strict flags
     * used for our own source it produces 16 errors, every one of them a
     * strictness complaint in their own logic — possibly-undefined array and map
     * lookups, and exact-optional mismatches — rather than a real defect. We do
     * not intend to rewrite third-party source to satisfy our preferences, and a
     * vendor copy that drifts from upstream is harder to audit than one that is
     * byte-identical apart from import rewriting.
     *
     * Relaxing the three flags below brings that tree to zero errors. Our own
     * code keeps all of them, because tsconfig.json excludes src/vendor and this
     * config excludes everything else.
     *
     * Relaxed: noUncheckedIndexedAccess, exactOptionalPropertyTypes,
     * strictNullChecks.
     */
    "strict": false,
    "noImplicitAny": true
  },
  "include": ["src/vendor/**/*.ts"],
  "exclude": ["upstream", "node_modules", "dist"]
}
