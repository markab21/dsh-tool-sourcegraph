# Compiled output of vitest.config.ts, emitted by nothing (the test config is
# noEmit). Kept out of the repository so a checked-in artifact cannot go stale.
vitest.config.js
vitest.config.d.ts
vitest.config.js.map

# Build output.
#
# dist/ is COMMITTED on purpose: it is the release artifact. The package
# declares no `prepare` script, because pnpm refuses to run one for a
# git-hosted install until the user allow-lists it — committing the build keeps
# `dsh plugin add <git-url>` working with no build step and no extra prompt.
# TypeScript's incremental metadata stays out of the repository.
*.tsbuildinfo
tsconfig.*.tsbuildinfo

# Dependencies
node_modules/

# pnpm content-addressable store, kept in-project by .npmrc so installs stay
# hermetic (the default store resolves through a stray workspace root in $HOME)
.pnpm-store/

# Test output
coverage/

# Local scratch: disposable DSH profiles, home dirs, and dev overlay patches
.scratch/
*.local.yml
.env
.env.*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Package manager
npm-debug.log*
pnpm-debug.log*
